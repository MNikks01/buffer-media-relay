# Required
BUFFER_API_KEY=            # Buffer → Settings → API
MONGO_URL=mongodb://127.0.0.1:27017
S3_BUCKET=buffer-media
PUBLIC_MEDIA_BASE_URL=https://pub-xxxx.r2.dev   # where the bucket's m/* objects are publicly served (https)

# S3-compatible store. AWS: set S3_REGION, omit S3_ENDPOINT. R2: S3_REGION=auto, S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=false
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= (read by the AWS SDK)

# HTTP API (npm run http)
# RELAY_API_KEY=           # 32+ chars; clients send Authorization: Bearer <key>
# PORT=8787

# MCP server (npm run mcp): local files the agent may upload must be under this folder
# MEDIA_ROOT=/Users/you/Pictures/buffer

# Optional
# MONGO_DB=buffer_media_relay
# LOG_LEVEL=info
# WORKER_INTERVAL_MS=60000
